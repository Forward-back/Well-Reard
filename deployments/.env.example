# =====================================================================
# Gaze 环境变量示例（当前六容器栈：frontend / app / docreader / ylsw / postgres / redis）
# 复制为 .env 后按需修改；.env 不应提交到版本控制。
# =====================================================================

# ---------- 镜像与构建 ----------
GAZE_VERSION=latest
# 国内构建加速；留空使用默认源
APK_MIRROR_ARG=mirrors.tencent.com
# WITH_ANYDOC=1
# NPM_REGISTRY=https://registry.npmmirror.com
# NODE_MAX_OLD_SPACE_SIZE=4096
# VITE_FRONTEND_COMMIT=

# ---------- 运行时 ----------
GIN_MODE=debug
# LOG_LEVEL=debug
# LOG_PATH=
TZ=Asia/Shanghai
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true
APP_HOST=app
APP_PORT=6152
# APP_BACKEND_PORT=8080
FRONTEND_PORT=6151
# MAX_FILE_SIZE_MB=50
# DEFAULT_LOCALE=

# ---------- 文档解析 ----------
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

# ---------- 数据库 ----------
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=root
DB_PASSWORD=CHANGE-ME
DB_NAME=WellRead

# ---------- 流管理 / Redis ----------
STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=stream:

# ---------- 文件存储 ----------
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files

# ---------- 检索 ----------
RETRIEVE_DRIVER=postgres

# ---------- Ollama（可选） ----------
OLLAMA_OPTIONAL=true
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- 安全 ----------
# 生产必须替换；TENANT_AES_KEY/SYSTEM_AES_KEY 为 32 字节密钥
JWT_SECRET=CHANGE-ME
SYSTEM_AES_KEY=CHANGE-ME-32-byte-key

# ---------- YLSW 检索引擎 ----------
# ylsw 仅 Docker 内网暴露，不占宿主端口
# App 与 YLSW 之间共享密钥；留空不启用
YLSW_ENGINE_TOKEN=
YLSW_MYSQL_HOST=host.docker.internal
YLSW_MYSQL_PORT=3306
YLSW_MYSQL_USER=root
YLSW_MYSQL_PASSWORD=CHANGE-ME
YLSW_MYSQL_DATABASE=YLSW_Service_Table
YLSW_EMPLOYEE_DB=ums_employee
YLSW_BGE_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
YLSW_BGE_API_KEY=
YLSW_BGE_RERANKER_URL=https://api.siliconflow.cn/v1/rerank
YLSW_DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
YLSW_DEEPSEEK_API_KEY=
YLSW_QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
YLSW_QWEN_API_KEY=
YLSW_API_TIMEOUT=30
YLSW_API_MAX_RETRIES=3

# ---------- 可观测性 ----------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ---------- 检索审计 ----------
# 检索审计保留天数；0 关闭清理
GAZE_RETRIEVAL_AUDIT_RETENTION_DAYS=30

# ---------- 并发 ----------
CONCURRENCY_POOL_SIZE=5

[Unit]
Description=Gaze first-boot initialization (runs once)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
Before=gaze.service
ConditionPathExists=/usr/local/sbin/gaze-firstboot.sh
ConditionPathExists=!/opt/Gaze/.firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gaze-firstboot.sh
RemainAfterExit=no
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
